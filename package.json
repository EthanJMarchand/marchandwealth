{
  "name": "marchand-wealth-site",
  "private": true,
  "version": "1.0.0",
  "description": "Marchand Wealth marketing site and client tools",
  "scripts": {
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./assets/css/site.css --minify",
    "watch:css": "tailwindcss -i ./src/tailwind.css -o ./assets/css/site.css --watch",
    "build:insights": "node scripts/build-insights.js",
    "build": "npm run build:css && npm run build:insights",
    "test:needs-analysis": "node needs-analysis/tests/calc.test.js"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
